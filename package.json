{
  "name": "@d1g1tal/watchr",
  "author": "D1g1talEntr0py",
  "version": "3.3.0",
  "license": "MIT",
  "description": "A native NodeJS file system watcher with optional rename detection support. Forked from github:fabiospampinato/watcher",
  "homepage": "https://github.com/D1g1talEntr0py/watchr#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/D1g1talEntr0py/watchr.git"
  },
  "bugs": {
    "url": "https://github.com/D1g1talEntr0py/watchr/issues"
  },
  "maintainers": [
    {
      "name": "D1g1talEntr0py",
      "email": "jason.dimeo@gmail.com"
    }
  ],
  "engines": {
    "node": ">=24.6.0"
  },
  "packageManager": "pnpm@12.3.4",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "types": "./dist/watchr.d.ts",
  "exports": {
    ".": {
      "types": "./dist/watchr.d.ts",
      "import": "./dist/watchr.js"
    }
  },
  "files": [
    "./dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node esbuild.config.ts",
    "build:watch": "tsc --watch --emitDeclarationOnly",
    "type-check": "tsc --noEmit",
    "lint": "eslint --flag unstable_native_nodejs_ts_config ./src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "bench": "pnpm build && node tests/benchmarks/watchr.bench.ts",
    "bench:compare": "pnpm build && node tests/benchmarks/compare.ts",
    "bench:compare:json": "pnpm build && node tests/benchmarks/compare.ts --format json",
    "bench:diagnostics": "pnpm build && node --expose-gc tests/benchmarks/diagnostics.bench.ts"
  },
  "dependencies": {
    "temporal-polyfill-lite": "^0.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.3.6",
    "memfs": "^4.71.0",
    "mitata": "^1.0.34",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "fs",
    "file",
    "system",
    "filesystem",
    "watch",
    "watcher",
    "watchr",
    "file-watcher",
    "fs.watch",
    "recursive",
    "inode",
    "rename-detection",
    "typescript"
  ]
}
