{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"isolatedDeclarations": false,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"rootDir": "."
	},
	"include": [
		"./esbuild.config.ts",
		"./vitest.config.ts",
		"./eslint.config.ts",
		"./build/**/*.ts",
		"./tests/benchmarks/**/*.ts"
	]
}
